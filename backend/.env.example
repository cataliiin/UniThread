# ==============================================================================
# UniThread - Backend Service Environment Variables Reference Template (.env.example)
# ==============================================================================

# Core Project Configurations
PROJECT_NAME="UniThread"
PROJECT_DESCRIPTION="UniThread Backend API"
DEBUG=False

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# [DOCKER COMPOSE SETUP] PostgreSQL Database via asyncpg connection driver
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@db:5432/unithread"

# [STANDALONE DEVELOPER SETUP] Standalone SQLite Database (uncomment to switch)
# DATABASE_URL="sqlite+aiosqlite:///./unithread.db"

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
# CHANGE THIS key in production environment to a secure random string (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="generate-a-long-random-string-here"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=True

# ------------------------------------------------------------------------------
# 3. Object Storage (MinIO)
# ------------------------------------------------------------------------------
# Inside Docker Compose bridge network, MinIO is accessible at 'minio:9000'
MINIO_ENDPOINT="minio:9000"
MINIO_PUBLIC_URL="http://localhost:9000"
# For Nginx proxy production mode:
# MINIO_PUBLIC_URL="http://localhost/storage"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadminpassword"
MINIO_SECURE=False

# ------------------------------------------------------------------------------
# 4. CORS & Healthcheck Configurations
# ------------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]
HEALTH_CHECK_INTERVAL=10
